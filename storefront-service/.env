# Server
HTTP_ADDR=0.0.0.0:8080
CURRENCY=USD

# Cart service (REST)
CART_BASE_URL=http://127.0.0.1:8083
CART_CLEAR_ENDPOINT=/api/cart

# Category service (GraphQL)
CATEGORY_GRAPHQL_URL=http://127.0.0.1:8084/graphql

# gRPC upstreams
ORDER_GRPC_URL=http://127.0.0.1:4000
PAYMENT_GRPC_URL=http://127.0.0.1:6001
INVENTORY_GRPC_URL=http://127.0.0.1:50051

# Redis (idempotency)
REDIS_URL=redis://127.0.0.1:6379
IDEMPOTENCY_TTL_SECS=86400

# Timeouts
UPSTREAM_TIMEOUT_SECS=10
IDEMPOTENCY_REQUIRED=true

# Tracing
RUST_LOG=storefront_service=debug,tower_http=info
SECRET_KEY=
RUST_BACKTRACE=1