# ===== Server =====
RUST_LOG=info,sqlx=warn,hyper=warn

SECRET_KEY=your_super_secret_key_here
BIND_ADDRESS=http://127.0.0.1:3000
DATABASE_URL=postgres://myuser:mypassword@127.0.0.1:5433/mydb?sslmode=disable
REDIS_URL=redis://:myredispassword@redis:6379

# ===== JWT =====
SECRET_KEY=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=auth-service
JWT_AUDIENCE=api-gateway

# ===== Argon2 =====
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ===== Email verification =====
EMAIL_VERIFICATION_EXPIRY=86400
EMAIL_VERIFY_RATE_LIMIT_SECS=60

# ===== SMTP =====
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_PUBLIC_URL=